<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Andro.ViewModels"
             xmlns:views="clr-namespace:Andro.Views"
             x:Class="Andro.Views.ChatPage"
             x:DataType="vm:ChatViewModel"
             Title="{Binding Title}">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="More" Command="{Binding MoreCommand}" />
    </ContentPage.ToolbarItems>

    <ContentPage.Resources>
        <DataTemplate x:Key="Incoming" x:DataType="vm:MessageItem">
            <Grid Padding="12,3,64,3">
                <Border HorizontalOptions="Start" Padding="12,8" StrokeThickness="0" StrokeShape="RoundRectangle 4,16,16,16"
                        BackgroundColor="{AppThemeBinding Light={StaticResource IncomingBubbleLight}, Dark={StaticResource IncomingBubbleDark}}">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="{Binding Text}" FontSize="15" />
                        <Label Text="{Binding Time}" Style="{StaticResource Caption}" FontSize="11" HorizontalOptions="End" />
                    </VerticalStackLayout>
                </Border>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="Outgoing" x:DataType="vm:MessageItem">
            <Grid Padding="64,3,12,3">
                <Border HorizontalOptions="End" Padding="12,8" StrokeThickness="0" StrokeShape="RoundRectangle 16,4,16,16"
                        BackgroundColor="{AppThemeBinding Light={StaticResource OutgoingBubbleLight}, Dark={StaticResource OutgoingBubbleDark}}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding RetryCommand, Source={RelativeSource AncestorType={x:Type vm:ChatViewModel}}, x:DataType=vm:ChatViewModel}" CommandParameter="{Binding .}" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="2">
                        <Label Text="{Binding Text}" FontSize="15" />
                        <HorizontalStackLayout Spacing="6" HorizontalOptions="End">
                            <Label Text="{Binding Time}" Style="{StaticResource Caption}" FontSize="11" />
                            <Label Text="{Binding StatusGlyph}" Style="{StaticResource Caption}" FontSize="11">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsFailed}" Value="True">
                                        <Setter Property="TextColor" Value="{StaticResource Danger}" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>
            </Grid>
        </DataTemplate>
        <views:MessageTemplateSelector x:Key="MessageTemplates" Incoming="{StaticResource Incoming}" Outgoing="{StaticResource Outgoing}" />
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*,Auto">
        <Border IsVisible="{Binding IsRequest}" Padding="16,10" StrokeThickness="0" BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray900}}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <Label Style="{StaticResource Caption}" VerticalOptions="Center"
                       Text="This person is not in your contacts. Only reply if you know who they are." />
                <Button Grid.Column="1" Text="Accept" Command="{Binding AcceptRequestCommand}" Padding="14,4" />
            </Grid>
        </Border>

        <CollectionView x:Name="MessageList" Grid.Row="1" ItemsSource="{Binding Messages}" ItemTemplate="{StaticResource MessageTemplates}" ItemsUpdatingScrollMode="KeepLastItemInView" />

        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="8" Padding="10,6,10,10">
            <Border Padding="12,0" StrokeShape="RoundRectangle 22" Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}">
                <Editor Text="{Binding Draft}" Placeholder="Message" AutoSize="TextChanges" MaximumHeightRequest="140" />
            </Border>
            <Button Grid.Column="1" Text="Send" Command="{Binding SendCommand}" VerticalOptions="End" CornerRadius="22" HeightRequest="44" />
        </Grid>
    </Grid>
</ContentPage>
