<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Andro.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:Andro.Views"
    Shell.FlyoutBehavior="Disabled"
    Shell.NavBarHasShadow="False"
    Title="Andro">

    <ShellContent Route="loading" ContentTemplate="{DataTemplate views:LoadingPage}" />
    <ShellContent Route="welcome" ContentTemplate="{DataTemplate views:WelcomePage}" />

    <!-- Main screens, with a bottom tab bar like WhatsApp. -->
    <TabBar Route="main">
        <Tab Title="Chats">
            <Tab.Icon>
                <FontImageSource FontFamily="MaterialIcons" Glyph="{x:Static views:Icons.Chat}" />
            </Tab.Icon>
            <ShellContent Route="chats" ContentTemplate="{DataTemplate views:ChatsPage}" />
        </Tab>
        <Tab Title="My ID">
            <Tab.Icon>
                <FontImageSource FontFamily="MaterialIcons" Glyph="{x:Static views:Icons.QrCode}" />
            </Tab.Icon>
            <ShellContent Route="myid" ContentTemplate="{DataTemplate views:MyIdPage}" />
        </Tab>
        <Tab Title="Settings">
            <Tab.Icon>
                <FontImageSource FontFamily="MaterialIcons" Glyph="{x:Static views:Icons.Settings}" />
            </Tab.Icon>
            <ShellContent Route="settings" ContentTemplate="{DataTemplate views:SettingsPage}" />
        </Tab>
    </TabBar>

</Shell>
