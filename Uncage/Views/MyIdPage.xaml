<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Uncage.ViewModels"
             xmlns:views="clr-namespace:Uncage.Views"
             x:Class="Uncage.Views.MyIdPage"
             x:DataType="vm:MyIdViewModel"
             BackgroundColor="{AppThemeBinding Light={StaticResource PillLight}, Dark={StaticResource PageDark}}">

    <Shell.TitleView>
        <Label Text="My ID" Style="{StaticResource AppTitle}" Margin="4,0" />
    </Shell.TitleView>

    <ScrollView>
        <VerticalStackLayout Padding="20,24" Spacing="20" MaximumWidthRequest="480">
            <Border Padding="24,20" StrokeThickness="0" StrokeShape="RoundRectangle 20"
                    BackgroundColor="{AppThemeBinding Light={StaticResource PageLight}, Dark={StaticResource IncomingDark}}">
                <VerticalStackLayout Spacing="14">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                        <Border Style="{StaticResource Avatar}" BackgroundColor="{Binding AvatarColor}">
                            <Label Text="{x:Static views:Icons.Person}" Style="{StaticResource Icon}" TextColor="White" FontSize="30" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                            <Label Text="You" Style="{StaticResource RowTitle}" FontFamily="OpenSansSemibold" FontSize="18" />
                            <Label Text="{Binding ShortId}" Style="{StaticResource Caption}" />
                        </VerticalStackLayout>
                    </Grid>

                    <Border BackgroundColor="White" Padding="10" StrokeThickness="0" StrokeShape="RoundRectangle 12" HorizontalOptions="Center">
                        <Image Source="{Binding QrCode}" WidthRequest="250" HeightRequest="250" SemanticProperties.Description="QR code of your ID" />
                    </Border>

                    <Label Text="{Binding Npub}" Style="{StaticResource Caption}" FontSize="12" HorizontalTextAlignment="Center" LineBreakMode="CharacterWrap" />
                </VerticalStackLayout>
            </Border>

            <Label Style="{StaticResource Caption}" HorizontalTextAlignment="Center"
                   Text="Your contacts scan this code to chat with you. It's public: it doesn't reveal your name, phone number or location." />

            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                <Button Text="Share" Style="{StaticResource PrimaryButton}" Command="{Binding ShareCommand}" />
                <Button Grid.Column="1" Text="Copy" Style="{StaticResource SecondaryButton}" Command="{Binding CopyCommand}" />
                <Button Grid.Column="2" Text="Scan" Style="{StaticResource SecondaryButton}" Command="{Binding ScanCommand}" />
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
