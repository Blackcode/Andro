<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Uncage.Views.LoadingPage"
             Shell.NavBarIsVisible="False">
    <VerticalStackLayout VerticalOptions="Center" Spacing="16" Padding="32">
        <ActivityIndicator x:Name="Spinner" IsRunning="True" HorizontalOptions="Center" />
        <Label x:Name="ErrorText" IsVisible="False" HorizontalTextAlignment="Center" />
        <Button x:Name="RetryButton" Text="Try again" IsVisible="False" Clicked="OnRetryClicked" HorizontalOptions="Center" />
    </VerticalStackLayout>
</ContentPage>
