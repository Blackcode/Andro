<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Uncage.ViewModels"
             xmlns:views="clr-namespace:Uncage.Views"
             x:Class="Uncage.Views.WelcomePage"
             x:DataType="vm:WelcomeViewModel"
             SafeAreaEdges="All"
             Shell.NavBarIsVisible="False">
    <ScrollView>
        <VerticalStackLayout Padding="28,56,28,32" Spacing="22" MaximumWidthRequest="480">
            <Border WidthRequest="120" HeightRequest="120" StrokeThickness="0" StrokeShape="RoundRectangle 60" HorizontalOptions="Center"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Green}, Dark={StaticResource GreenDark}}">
                <Label Text="{x:Static views:Icons.Lock}" Style="{StaticResource Icon}" FontSize="60"
                       TextColor="{AppThemeBinding Light=White, Dark={StaticResource PageDark}}" />
            </Border>

            <Label Text="Welcome to Uncage" FontSize="26" FontFamily="OpenSansSemibold" HorizontalTextAlignment="Center"
                   TextColor="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />

            <VerticalStackLayout Spacing="14">
                <Grid ColumnDefinitions="40,*">
                    <Label Text="{x:Static views:Icons.Person}" Style="{StaticResource Icon}" TextColor="{StaticResource Green}" />
                    <Label Grid.Column="1" Style="{StaticResource Caption}" FontSize="15" Text="No phone number, email or account. Your identity is a key created on this device." />
                </Grid>
                <Grid ColumnDefinitions="40,*">
                    <Label Text="{x:Static views:Icons.Lock}" Style="{StaticResource Icon}" TextColor="{StaticResource Green}" />
                    <Label Grid.Column="1" Style="{StaticResource Caption}" FontSize="15" Text="End-to-end encrypted, and hides who is talking to whom." />
                </Grid>
                <Grid ColumnDefinitions="40,*">
                    <Label Text="{x:Static views:Icons.Relays}" Style="{StaticResource Icon}" TextColor="{StaticResource Green}" />
                    <Label Grid.Column="1" Style="{StaticResource Caption}" FontSize="15" Text="Travels through many independent relays worldwide, optionally over Tor, so no single company or government can switch it off." />
                </Grid>
            </VerticalStackLayout>

            <Button Text="Create my identity" Style="{StaticResource PrimaryButton}" Margin="0,10,0,0"
                    Command="{Binding CreateCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBool}}" />

            <Label Text="Restore from a backup key" Style="{StaticResource SectionTitle}" Margin="0,8,0,0" HorizontalOptions="Center" />
            <Border Style="{StaticResource FieldBox}">
                <Entry Placeholder="nsec1…" Text="{Binding BackupKey}" IsPassword="True" Style="{StaticResource PlainEntry}" />
            </Border>
            <Button Text="Restore" Style="{StaticResource SecondaryButton}" Command="{Binding RestoreCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBool}}" />

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="{StaticResource Green}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
