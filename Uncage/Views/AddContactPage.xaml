<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Uncage.ViewModels"
             xmlns:views="clr-namespace:Uncage.Views"
             x:Class="Uncage.Views.AddContactPage"
             x:DataType="vm:AddContactViewModel"
             SafeAreaEdges="All"
             Shell.TabBarIsVisible="False"
             Title="New chat">
    <ScrollView>
        <VerticalStackLayout Padding="0,8,0,24" MaximumWidthRequest="560">

            <!-- Like WhatsApp's "New contact / scan QR" rows -->
            <Grid ColumnDefinitions="72,*" Padding="0,10,16,10">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ScanCommand}" />
                </Grid.GestureRecognizers>
                <Border Style="{StaticResource Avatar}" BackgroundColor="{AppThemeBinding Light={StaticResource Green}, Dark={StaticResource GreenDark}}" HorizontalOptions="Center">
                    <Label Text="{x:Static views:Icons.QrScanner}" Style="{StaticResource Icon}" TextColor="{AppThemeBinding Light=White, Dark={StaticResource PageDark}}" />
                </Border>
                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                    <Label Text="Scan QR code" Style="{StaticResource RowTitle}" FontFamily="OpenSansSemibold" />
                    <Label Text="Best done in person, so you know the ID is really theirs" Style="{StaticResource Caption}" />
                </VerticalStackLayout>
            </Grid>

            <Grid ColumnDefinitions="72,*" Padding="0,10,16,10">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding PasteCommand}" />
                </Grid.GestureRecognizers>
                <Border Style="{StaticResource Avatar}" BackgroundColor="{AppThemeBinding Light={StaticResource Green}, Dark={StaticResource GreenDark}}" HorizontalOptions="Center">
                    <Label Text="{x:Static views:Icons.Copy}" Style="{StaticResource Icon}" TextColor="{AppThemeBinding Light=White, Dark={StaticResource PageDark}}" />
                </Border>
                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                    <Label Text="Paste an ID" Style="{StaticResource RowTitle}" FontFamily="OpenSansSemibold" />
                    <Label Text="From a message or email your contact sent you" Style="{StaticResource Caption}" />
                </VerticalStackLayout>
            </Grid>

            <Label Text="Contact" Style="{StaticResource SectionTitle}" />
            <VerticalStackLayout Padding="20,0" Spacing="12">
                <Border Style="{StaticResource FieldBox}">
                    <Entry Placeholder="Their ID (npub1…)" Text="{Binding PublicKey}" Style="{StaticResource PlainEntry}" />
                </Border>
                <Border Style="{StaticResource FieldBox}">
                    <Entry Placeholder="Name (only you see it)" Text="{Binding Name}" MaxLength="60" Style="{StaticResource PlainEntry}" IsSpellCheckEnabled="True" />
                </Border>
                <Button Text="Start chat" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" Margin="0,8,0,0" />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
