<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Uncage.ViewModels"
             xmlns:views="clr-namespace:Uncage.Views"
             x:Class="Uncage.Views.ChatsPage"
             x:DataType="vm:ChatsViewModel">

    <Shell.TitleView>
        <Grid ColumnDefinitions="*,Auto" Padding="4,0,8,0">
            <Label Text="Uncage" Style="{StaticResource AppTitle}" />
            <ImageButton Grid.Column="1" Command="{Binding ScanCommand}" WidthRequest="44" HeightRequest="44" Padding="10"
                         BackgroundColor="Transparent" SemanticProperties.Description="Scan a QR code">
                <ImageButton.Source>
                    <FontImageSource FontFamily="MaterialIcons" Glyph="{x:Static views:Icons.QrScanner}"
                                     Color="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />
                </ImageButton.Source>
            </ImageButton>
        </Grid>
    </Shell.TitleView>

    <Grid RowDefinitions="Auto,Auto,Auto,*">
        <!-- Search -->
        <Border Style="{StaticResource Pill}" Margin="16,4,16,8" Padding="14,0" HeightRequest="46">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <Label Text="{x:Static views:Icons.Search}" Style="{StaticResource Icon}" FontSize="22" />
                <Entry Grid.Column="1" Text="{Binding SearchText}" Placeholder="Search" Style="{StaticResource PlainEntry}" VerticalOptions="Center"
                       PlaceholderColor="{AppThemeBinding Light={StaticResource SubTextLight}, Dark={StaticResource SubTextDark}}" />
            </Grid>
        </Border>

        <!-- Filter chips -->
        <HorizontalStackLayout Grid.Row="1" Spacing="8" Padding="16,0,16,6">
            <Border Style="{StaticResource Chip}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding SetFilterCommand}" CommandParameter="{x:Static vm:ChatFilter.All}" />
                </Border.GestureRecognizers>
                <Border.Triggers>
                    <DataTrigger TargetType="Border" Binding="{Binding IsAll}" Value="True">
                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource ChipOnLight}, Dark={StaticResource ChipOnDark}}" />
                    </DataTrigger>
                </Border.Triggers>
                <Label Text="All" Style="{StaticResource Caption}" FontSize="14" />
            </Border>
            <Border Style="{StaticResource Chip}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding SetFilterCommand}" CommandParameter="{x:Static vm:ChatFilter.Unread}" />
                </Border.GestureRecognizers>
                <Border.Triggers>
                    <DataTrigger TargetType="Border" Binding="{Binding IsUnread}" Value="True">
                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource ChipOnLight}, Dark={StaticResource ChipOnDark}}" />
                    </DataTrigger>
                </Border.Triggers>
                <Label Text="Unread" Style="{StaticResource Caption}" FontSize="14" />
            </Border>
            <Border Style="{StaticResource Chip}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding SetFilterCommand}" CommandParameter="{x:Static vm:ChatFilter.Requests}" />
                </Border.GestureRecognizers>
                <Border.Triggers>
                    <DataTrigger TargetType="Border" Binding="{Binding IsRequests}" Value="True">
                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource ChipOnLight}, Dark={StaticResource ChipOnDark}}" />
                    </DataTrigger>
                </Border.Triggers>
                <Label Text="Requests" Style="{StaticResource Caption}" FontSize="14" />
            </Border>
        </HorizontalStackLayout>

        <!-- Only shown while no relay is reachable -->
        <Label Grid.Row="2" Text="{Binding ConnectionText}" IsVisible="{Binding IsOffline}" Style="{StaticResource Caption}"
               HorizontalTextAlignment="Center" Padding="16,2,16,6" TextColor="{StaticResource Danger}" />

        <CollectionView Grid.Row="3" ItemsSource="{Binding Conversations}">
            <CollectionView.EmptyView>
                <Label Text="{Binding EmptyText}" Style="{StaticResource Caption}" FontSize="15"
                       HorizontalTextAlignment="Center" VerticalOptions="Center" Padding="40" />
            </CollectionView.EmptyView>
            <CollectionView.Footer>
                <HorizontalStackLayout HorizontalOptions="Center" Spacing="4" Padding="0,18,0,96">
                    <Label Text="{x:Static views:Icons.Lock}" Style="{StaticResource Icon}" FontSize="13" />
                    <Label Text="Your messages are end-to-end encrypted" Style="{StaticResource Caption}" FontSize="12" />
                </HorizontalStackLayout>
            </CollectionView.Footer>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:ConversationItem">
                    <Grid Padding="16,10" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14" RowDefinitions="Auto,Auto" RowSpacing="2">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Open}" CommandParameter="{Binding .}" />
                        </Grid.GestureRecognizers>

                        <Border Grid.RowSpan="2" Style="{StaticResource Avatar}" BackgroundColor="{Binding AvatarColor}" VerticalOptions="Center">
                            <Grid>
                                <Label Text="{Binding Initial}" Style="{StaticResource AvatarInitial}" IsVisible="{Binding HasName}" />
                                <Label Text="{x:Static views:Icons.Person}" Style="{StaticResource Icon}" TextColor="White" FontSize="30"
                                       IsVisible="{Binding HasName, Converter={StaticResource InvertedBool}}" />
                            </Grid>
                        </Border>

                        <Label Grid.Column="1" Text="{Binding Title}" Style="{StaticResource RowTitle}" FontFamily="OpenSansSemibold" LineBreakMode="TailTruncation" VerticalOptions="End" />
                        <Label Grid.Column="2" Text="{Binding Time}" Style="{StaticResource Caption}" FontSize="12" VerticalOptions="End">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding HasUnread}" Value="True">
                                    <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Green}, Dark={StaticResource GreenDark}}" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>

                        <HorizontalStackLayout Grid.Row="1" Grid.Column="1" Spacing="3">
                            <Label Text="{Binding StatusGlyph}" IsVisible="{Binding HasStatus}" Style="{StaticResource Icon}" FontSize="16">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsFailed}" Value="True">
                                        <Setter Property="TextColor" Value="{StaticResource Danger}" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                            <Label Text="{Binding Preview}" Style="{StaticResource Caption}" FontSize="14" MaxLines="1" LineBreakMode="TailTruncation" />
                        </HorizontalStackLayout>
                        <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource Badge}" IsVisible="{Binding HasUnread}" HorizontalOptions="End">
                            <Label Text="{Binding UnreadText}" FontSize="12" FontFamily="OpenSansSemibold" HorizontalOptions="Center" VerticalOptions="Center"
                                   TextColor="{AppThemeBinding Light=White, Dark={StaticResource PageDark}}" />
                        </Border>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- New chat -->
        <Border Grid.Row="3" Style="{StaticResource Fab}" SemanticProperties.Description="New chat">
            <Border.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding NewChatCommand}" />
            </Border.GestureRecognizers>
            <Label Text="{x:Static views:Icons.NewChat}" Style="{StaticResource Icon}" FontSize="26"
                   TextColor="{AppThemeBinding Light=White, Dark={StaticResource PageDark}}" />
        </Border>
    </Grid>
</ContentPage>
